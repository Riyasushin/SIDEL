{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "small_model": "{env:OPENCODE_MODEL}",
  "provider": {
    "local-router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Docker Router",
      "options": {
        "baseURL": "{env:ROUTER_BASE_URL}",
        "apiKey": "{env:ROUTER_API_KEY}"
      },
      "models": {
        "router-fixed": {
          "name": "Router fixed response"
        },
        "router-tool-call": {
          "name": "Router controlled tool-call"
        },
        "kimi-for-coding": {
          "name": "Kimi Code via router"
        },
        "deepseek-chat": {
          "name": "DeepSeek via router"
        }
      }
    }
  }
}
